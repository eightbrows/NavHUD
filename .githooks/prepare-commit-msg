#!/bin/bash
# コミットメッセージの先頭に app/build.gradle.kts の appVersionName を挿入する。
#   例: "20260926-D01: メッセージ"
# 有効化: git config core.hooksPath .githooks
COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2

# 対象は通常のコミットのみ。
#   ""        : エディタで書くコミット
#   message   : git commit -m / -F（Android Studio のコミットもこれ）
#   template  : git commit -t / commit.template
# merge / squash / commit(--amend, -c, -C) では何もしない。
case "$COMMIT_SOURCE" in
    ""|message|template) ;;
    *) exit 0 ;;
esac

# リベース・cherry-pick・revert の途中では何もしない。
GIT_DIR=$(git rev-parse --git-dir)
for s in rebase-merge rebase-apply CHERRY_PICK_HEAD REVERT_HEAD MERGE_HEAD; do
    [[ -e "$GIT_DIR/$s" ]] && exit 0
done

ROOT=$(git rev-parse --show-toplevel)
VERSION=$(sed -nE 's/^[[:space:]]*val[[:space:]]+appVersionName[[:space:]]*=[[:space:]]*"([^"]+)".*/\1/p' \
    "$ROOT/app/build.gradle.kts" | head -n 1)

[[ -z "$VERSION" ]] && exit 0

# 既に先頭にバージョン（この形式なら何でも）が入っていれば二重に入れない。
if head -n 1 "$COMMIT_MSG_FILE" | grep -qE '^[0-9]{8}-[DR][0-9]{2}: '; then
    exit 0
fi

sed -i "1s/^/$VERSION: /" "$COMMIT_MSG_FILE"
